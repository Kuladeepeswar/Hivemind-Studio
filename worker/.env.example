# Copy to worker/.env for local development. Never commit the real file.
# On Render these are set in the dashboard instead; there is no .env there.

# Neon pooled connection string. Not needed for test_cli.py.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Redis / Render Key Value. Not needed for test_cli.py.
REDIS_URL=redis://localhost:6379

# At least ONE of these is required. Tried in this order, so a daily cap on one
# provider does not take the app down.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides. Free model IDs rotate often; change them here rather
# than in code when a provider retires one.
# GROQ_MODEL=openai/gpt-oss-120b
# CEREBRAS_MODEL=qwen-3.8-27b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
