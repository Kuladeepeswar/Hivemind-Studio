# Copy to api/.env for local development. Never commit the real file.
# On Render these are set in the dashboard instead; there is no .env there.

# Same Neon connection string the worker uses.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

REDIS_URL=redis://localhost:6379

# Where to send the wake-up ping. Must be the worker's PUBLIC url in production:
# an internal-network request will not wake a free service that has spun down.
WORKER_URL=http://localhost:10000

PORT=3000
