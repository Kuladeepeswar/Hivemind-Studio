# Copy to frontend/.env.local for local development. Never commit the real file.
#
# On Render this is injected at BUILD time by render.yaml from the api service, so
# you do not set it there. Vite bakes it into the bundle, which means changing it
# later requires rebuilding the frontend, not just restarting it.
#
# A bare hostname works too - src/config.js adds the scheme.
VITE_API_URL=http://localhost:3000

# Optional. Defaults to VITE_API_URL with a wss:// scheme, which is almost always
# what you want. Set it only if the websocket lives on a different host.
# VITE_WS_URL=
